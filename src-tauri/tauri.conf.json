{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ref",
  "version": "0.1.0",
  "identifier": "com.liuliubiu.quick-ms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ref",
        "width": 300,
        "height": 430,
        "minWidth": 220,
        "minHeight": 200,
        "maxWidth": 320,
        "maxHeight": 460,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "skipTaskbar": false,
        "maximizable": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
